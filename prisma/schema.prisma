generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model city_events {
  id          BigInt                 @id @default(autoincrement())
  type        String?                @db.VarChar(20)
  title       String?                @db.VarChar(100)
  description String?                @db.Text
  lat         Decimal?               @db.Decimal(10, 8)
  lng         Decimal?               @db.Decimal(11, 8)
  img_url     String?                @db.VarChar(255)
  start_at    DateTime?              @db.DateTime(0)
  end_at      DateTime?              @db.DateTime(0)
  created_by  BigInt?
  created_at  DateTime?              @db.DateTime(0)
  is_active   city_events_is_active? @default(Y)
  deleted_at  DateTime?              @db.DateTime(0)
  user        user?                  @relation(fields: [created_by], references: [id], map: "FK_city_events_user")

  @@index([created_by], map: "FK_city_events_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model device_tokens {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt?
  device_token String    @unique(map: "UQ_device_token") @db.VarChar(255)
  last_lat     Decimal?  @db.Decimal(10, 8)
  last_lng     Decimal?  @db.Decimal(11, 8)
  created_at   DateTime? @db.DateTime(0)
  updated_at   DateTime? @db.DateTime(0)
  user         user?     @relation(fields: [user_id], references: [id], map: "FK_device_tokens_user")

  @@index([user_id], map: "FK_device_tokens_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model feedback {
  id             BigInt              @id @default(autoincrement())
  user_id        BigInt?
  grid_id        BigInt?
  safety_feeling String?             @default("보통") @db.VarChar(20)
  comment        String?             @db.Text
  img_url        String?             @db.VarChar(255)
  is_active      feedback_is_active? @default(Y)
  created_at     DateTime?           @db.DateTime(0)
  grid           grid?               @relation(fields: [grid_id], references: [id], onDelete: Cascade, map: "FK_feedback_grid")
  user           user?               @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "FK_feedback_user")
  feedback_tag   feedback_tag[]

  @@index([grid_id], map: "FK_feedback_grid")
  @@index([user_id], map: "FK_feedback_user")
}

model feedback_tag {
  feedback_id BigInt
  tag_id      BigInt
  feedback    feedback @relation(fields: [feedback_id], references: [id], onDelete: Cascade, map: "FK_feedback_tag_feedback")
  tag         tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade, map: "FK_feedback_tag_tag")

  @@id([feedback_id, tag_id])
  @@index([feedback_id], map: "FK_feedback_tag_feedback")
  @@index([tag_id], map: "FK_feedback_tag_tag")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model grid {
  id              BigInt            @id @default(autoincrement())
  grid_row        Int?
  grid_col        Int?
  lat             Decimal?          @db.Decimal(10, 8)
  lng             Decimal?          @db.Decimal(11, 8)
  infra_count     Int?
  safety_grade    String?           @db.VarChar(20)
  feedback        feedback[]
  infrastructures infrastructures[]
  report          report[]

  @@unique([grid_row, grid_col], map: "UQ_grid_row_col")
}

model infrastructures {
  id      BigInt   @id @default(autoincrement())
  grid_id BigInt?
  type    String?  @db.VarChar(50)
  address String?  @db.VarChar(50)
  lng     Decimal? @db.Decimal(11, 8)
  lat     Decimal? @db.Decimal(10, 8)
  grid    grid?    @relation(fields: [grid_id], references: [id], onDelete: Cascade, map: "FK_infrastructures_grid")

  @@index([grid_id], map: "FK_infrastructures_grid")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model report {
  id          BigInt            @id @default(autoincrement())
  user_id     BigInt?
  grid_id     BigInt?
  type        String?           @db.VarChar(50)
  lat         Decimal?          @db.Decimal(10, 8)
  lng         Decimal?          @db.Decimal(11, 8)
  description String?           @db.Text
  img_url     String?           @db.VarChar(255)
  is_active   report_is_active? @default(Y)
  created_at  DateTime?         @db.DateTime(0)
  expire_at   DateTime?         @db.DateTime(0)
  grid        grid?             @relation(fields: [grid_id], references: [id], onDelete: Cascade, map: "FK_report_grid")
  user        user?             @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "FK_report_user")

  @@index([grid_id], map: "FK_report_grid")
  @@index([user_id], map: "FK_report_user")
}

model tag {
  id           BigInt         @id @default(autoincrement())
  name         String?        @db.VarChar(50)
  feedback_tag feedback_tag[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user {
  id            BigInt          @id @default(autoincrement())
  password_hash String?         @db.VarChar(255)
  email         String?         @db.VarChar(50)
  nickname      String?         @db.VarChar(50)
  role          user_role?      @default(USER)
  created_at    DateTime?       @db.DateTime(0)
  is_active     user_is_active? @default(Y)
  city_events   city_events[]
  device_tokens device_tokens[]
  feedback      feedback[]
  refresh_token refresh_token[]
  report        report[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model refresh_token {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token_hash String    @unique(map: "token_hash") @db.VarChar(255)
  expires_at DateTime  @db.DateTime(0)
  revoked_at DateTime? @db.DateTime(0)
  created_at DateTime? @db.DateTime(0)
  user       user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_refresh_token_user")

  @@index([user_id], map: "FK_refresh_token_user")
}

enum feedback_is_active {
  Y
  N
}

enum user_is_active {
  Y
  N
}

enum report_is_active {
  Y
  N
}

enum city_events_is_active {
  Y
  N
}

enum user_role {
  USER
  ADMIN
}
