PORT=5000
DATABASE_URL=DB주소
JWT_SECRET=readme.md 참조
SESSION_SECRET=readme.md 참조
# --- 안전등급 일일 배치 (매일 00:00, Asia/Seoul) ---
# true: 서버 기동 시 cron 등록 / false: 스케줄 끔 (개발 중 자정 실행이 부담일 때)
SCORE_CRON_ENABLED=true
# cron 시간대 (한국 자정 기준)
SCORE_CRON_TZ=Asia/Seoul
# --- 마스킹 Python 경로 ---
MASKING_PYTHON=D:\public_safety_map_backend\masking\.venv\Scripts\python.exe
# --> 마스킹 패스 개인 경로로 수정

# --- 교통사고 데이터 조회 API ---
KOROAD_AUTH_KEY=KEY값
KOROAD_BASE_URL=https://opendata.koroad.or.kr/data/rest/frequentzone

UPLOAD_DIR=/app/uploads


#firebase
FIREBASE_PROJECT_ID=프로젝트ID
FIREBASE_CLIENT_EMAIL=클라이언트이메일
FIREBASE_PRIVATE_KEY=프라이빗키